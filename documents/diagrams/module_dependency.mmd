    style Menu fill:#ff6b6b,color:#fff
    style Setup fill:#ff6b6b,color:#fff
    style SessionUI fill:#ff6b6b,color:#fff
    style Results fill:#ff6b6b,color:#fff
    style History fill:#ff6b6b,color:#fff
    style BreathingBar fill:#ff6b6b,color:#fff
    style PhaseMap fill:#ff6b6b,color:#fff
    style StorageMod fill:#ffa500,color:#fff
    style Store fill:#ffa500,color:#fff
    style Schema fill:#ffa500,color:#fff
    style Ratatui fill:#9b59b6,color:#fff
    style Crossterm fill:#9b59b6,color:#fff
    style Tokio fill:#9b59b6,color:#fff
    style Serde fill:#9b59b6,color:#fff
